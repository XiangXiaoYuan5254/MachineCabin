{
  "name": "vbcoding-service-console",
  "private": true,
  "version": "1.2.0",
  "description": "本地开发服务控制台",
  "author": "xxy",
  "type": "module",
  "main": "desktop/main.js",
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,cyan \"node --watch server/index.js\" \"vite --host 127.0.0.1\"",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "node --test server/lib/discovery.test.js server/lib/process-manager.test.js server/lib/platform/win32.test.js src/update.test.js",
    "desktop": "vite build && electron .",
    "dist:win": "node script/package_windows.mjs"
  },
  "dependencies": {
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^6.0.7"
  }
}
